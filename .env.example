# Copy to .env.local for local dev; set the same names in Vercel (Project → Settings → Environment Variables).

# Supabase → Project Settings → API. Safe to expose to the browser (RLS is enabled on all tables).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server only. Used to invite members (auth.admin). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → pooled connection string (transaction mode, port 6543). Used by the app at runtime.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional: direct/session connection (port 5432) used only by `pnpm db:migrate`. Falls back to DATABASE_URL.
DIRECT_URL=

# Public URL of the deployed app, used in invite/reset email links (e.g. https://your-app.vercel.app).
# Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000
